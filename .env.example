# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# ── Database (optional) ──────────────────────────────────────────────────────
# Neon Postgres. With this unset, Adopt runs the seeded demo organisation from
# memory so the product is never a dead page waiting on infrastructure — the UI
# says which mode it is in.
#
#   1) Create a free project at https://neon.tech
#   2) Copy the POOLED connection string
#   3) Paste it below, then: npm run db:setup
#
# Server-only. Never prefix with NEXT_PUBLIC_.
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Credential encryption (required for vendor connectors) ───────────────────
# Vendor admin credentials (Graph client secrets, GitHub PATs, Anthropic admin
# keys) are encrypted with AES-256-GCM before they touch the database. The key
# lives only here, so a database dump is not a credential leak.
#
#   openssl rand -base64 32
#
# Rotating this key makes every stored credential unreadable — connections must
# be re-entered. There is no fallback default on purpose: a default would mean
# credentials encrypted with a publicly known key.
# ADOPT_ENCRYPTION_KEY=

# ── Model backend (optional) ─────────────────────────────────────────────────
# Routing is deterministic and needs no model. A model is used only by
# /api/improve, the evaluator-optimizer that rewrites an underperforming prompt.
# With nothing set it falls back to a heuristic.
LLM_PROVIDER=demo

# LLM_PROVIDER=ollama          # local model, free and private
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434

# LLM_PROVIDER=openai          # any OpenAI-compatible endpoint (Groq free tier, OpenRouter, LM Studio)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...

# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# LLM_API_KEY=sk-ant-...
