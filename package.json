{
  "name": "adopt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:security": "node tests/security.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:routing": "rm -rf .tsbuild && tsc lib/catalog.ts lib/routing.ts tests/routing.test.ts --module commonjs --target es2022 --moduleResolution node --outDir .tsbuild --skipLibCheck && node .tsbuild/tests/routing.test.js",
    "db:setup": "node --env-file-if-exists=.env.local db/seed.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.14",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "sharp": "^0.35.4"
  }
